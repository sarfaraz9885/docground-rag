# --- DocGround RAG: configuration template ---
# Copy this file to `.env` and fill in your real values. NEVER commit `.env`.

# OpenAI: REQUIRED (embeddings + default chat LLM).
OPENAI_API_KEY=

# Pinecone: REQUIRED (vector store). Get a key at https://app.pinecone.io
PINECONE_API_KEY=

# Anthropic: OPTIONAL. Only needed if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# LangSmith tracing (OPTIONAL; auto-read by LangChain when set).
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Which provider answers questions / judges faithfulness: "openai" or "anthropic".
LLM_PROVIDER=openai

# Model names.
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small

# Pinecone serverless index (auto-created on first ingest).
# Dimension is derived from EMBEDDING_MODEL: text-embedding-3-small -> 1536.
PINECONE_INDEX=docground-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Base URL the Streamlit UI uses to reach the FastAPI server (API mode only).
API_BASE_URL=http://localhost:8000
